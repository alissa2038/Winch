#!/usr/bin/env python3


import sys
import threading
import time
import pigpio
import math
import socket
import json
import argparse
import csv

# =====================
#   ウインチ設定 (ハードウェア定数)
# =====================
PIN                = 18
STOP_fwd           = 1440
STOP_center        = 1400
STOP_rev           = 1370


PWM_FWD_MIN        = 1455   # 正転の最小値 (1%)
PWM_FWD_MAX        = 1800   # 正転の最大値 (100%)
PWM_REV_MAX        = 1345   # 逆転の最小値 (1% - 数字が大きいほど遅い)
PWM_REV_MIN        = 1000   # 逆転の最大値 (100% - 数字が小さいほど速い)


ESTIMATED_ROT_PER_SEC = 0.2 # RPS
WINCH_RADIUS = 0.10         # ドラム半径 (10cm)

MAX_SPEED_M_MIN = 15.0

DEFAULT_PORT = 8090

# =====================
#   エンコーダー設定
# =====================
SENSOR_PIN             = 4              # 緑のケーブルのGPIOピン
MAGNET_PAIRS           = 2             # ロータリーエンコーダーの磁石ペア数
WHEEL_DIAMETER_MM      = 32            # ホイールの直径（mm）
WHEEL_CIRCUMFERENCE_MM = math.pi * WHEEL_DIAMETER_MM  # 1回転あたり約100.53 mm
ENCODER_CSV_FILENAME   = 'peak_measurements.csv'


# ==========================================
# 1. サーバーデータ (受信データ)
# ==========================================
class ServerCommand:
    def __init__(self):
        self.run_flag = False      # False = 停止, True = 動作中
        self.target_depth_m = 0.0  # 目標深度 (m)
        self.rate = 20             # 要求速度 (0-100%)

# ==========================================
# 2. ウィンチ状態 (送信データ)
# ==========================================
class WinchStatus:
    def __init__(self):
        self.run_flag = False              # False = 完全停止, True = 動作中（または減速中）
        self.current_depth_m = 0.0         # 現在の深度
        self.depth_estimated_flag = True  # (is_estimated) --> False = センサー計測, True = 回転数による推定
        self.speed = 0.0                   # 現在の速度
        self.state_name = "IDLE"           # 現在の状態 (IDLE, TRACKING, SOFT_STOP, RETRIEVE_TO_HOME)

# ==========================================
# 3.  TCP サーバー 
# ==========================================
def tcp_server(controller, port):
    """
    TCPサーバーを起動し、クライアントからの NDJSON を受け付ける。
    各クライアント接続は別スレッドで処理する。
    """
    server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    # ポート再利用を許可（再起動時に "Address already in use" を防ぐ）
    server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server_sock.bind(("0.0.0.0", port))
    server_sock.listen(5)
    print(f"[TCP] ポート {port} で待機中...")
 
    while controller.running:
        try:
            server_sock.settimeout(1.0)  # 1秒ごとにrunningフラグを確認
            try:
                conn, addr = server_sock.accept()
            except socket.timeout:
                continue
            print(f"\n[TCP] 接続: {addr}")
            t = threading.Thread(
                target=handle_client,
                args=(conn, addr, controller),
                daemon=True
            )
            t.start()
        except Exception as e:
            if controller.running:
                print(f"[TCP] サーバーエラー: {e}")
 
    server_sock.close()
    print("[TCP] サーバー終了")


def handle_client(conn, addr, controller):
    """
    1クライアントとの通信を担当する。
    NDJSON (改行区切りJSON) を受信し、レスポンスを返す。
    """
    buffer = ""
    try:
        with conn:
            conn.settimeout(30.0)  # 30秒無通信でタイムアウト
            while controller.running:
                try:
                    chunk = conn.recv(1024).decode("utf-8")
                except socket.timeout:
                    # タイムアウトしても接続は維持する
                    continue
 
                if not chunk:
                    # クライアントが切断した
                    break
 
                buffer += chunk
 
                # 改行が来るまでバッファに溜める (NDJSON)
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
 
                    response = process_command(line, controller)
                    # レスポンスも NDJSON (末尾に改行)
                    conn.sendall((response + "\n").encode("utf-8"))
 
    except Exception as e:
        print(f"\n[TCP] クライアント {addr} エラー: {e}")
    finally:
        print(f"\n[TCP] 切断: {addr}")

 
def process_command(raw_json: str, controller) -> str:
    """
    受信した JSON 文字列を解析し、get / set を処理してレスポンス JSON を返す。
    """
    try:
        data = json.loads(raw_json)
    except json.JSONDecodeError as e:
        return json.dumps({"status": "error", "error": f"JSON parse error: {e}"})
 
    command = data.get("command")

    # --------------------------------------------------
    # GET: 現在のウィンチ状態を返す
    # --------------------------------------------------
    if command == "get":
        status = controller.status
        # depth: 精度0.1m → ×10 して uint16 で返す (例: 1.5m → 15)
        depth_encoded = int(round(status.current_depth_m * 10))
        # speed: 精度0.1m/min → ×10 して uint16 で返す
        speed_encoded = int(status.speed)
 
        response = {
            "state":        1 if status.run_flag else 0,
            "depth":        depth_encoded,
            "is_estimated": 1 if status.depth_estimated_flag else 0,
            "speed":        speed_encoded,
        }
        return json.dumps(response)

    # --------------------------------------------------
    # SET: ウィンチに指令を送る
    # --------------------------------------------------
    elif command == "set":
        try:
            state = int(data["state"])   # 0=停止, 1=稼働
            # depth: ×10 エンコード値を受け取り、÷10 して実メートルに戻す (例: 20 → 2.0m)
            depth_encoded = int(data["depth"])
            rate  = int(data["rate"])    # 0〜100%
 
            target_depth_m = depth_encoded / 10.0
 
            # ServerCommand に反映
            controller.cmd.run_flag      = (state == 1)
            controller.cmd.target_depth_m = target_depth_m
            controller.cmd.rate          = rate
 
            return json.dumps({"status": "ok"})
 
        except (KeyError, ValueError, TypeError) as e:
            return json.dumps({"status": "error", "error": f"invalid set parameters: {e}"})
 
    # --------------------------------------------------
    # 不明なコマンド
    # --------------------------------------------------
    else:
        return json.dumps({"status": "error", "error": f"unknown command: {command!r}"})

# ==========================================
# 4. ウィンチコントローラー (メインロジック)
# ==========================================
class WinchControllerV1:
    def __init__(self, port=DEFAULT_PORT):
        self.port = port
        self.cmd = ServerCommand()
        self.status = WinchStatus()

        # =====================
        #   pigpio 初期化 & モーター変数
        # =====================

        self.pi = pigpio.pi()
        if not self.pi.connected:
            print("pigpiod が起動していません: sudo pigpiod")
            sys.exit()

        self.running = True
        self.emergency = False          # 緊急停止フラグ
        self.target_pwm = STOP_center   # 目標の速度
        self.current_pwm = STOP_center  # 現在のモーターの速度
        self.num_rotations = 0.0
        self.reached_full_speed = False #SLOW_down用

        # =====================
        #   エンコーダー変数
        # =====================
        self.encoder_lock = threading.Lock()
        self.pulse_count = 0
        self.encoder_start_time = time.monotonic()
        self.encoder_writer = None
        self.encoder_csv_file = None
 
        # エンコーダーセンサーの初期化（pigpio使用）
        self.pi.set_mode(SENSOR_PIN, pigpio.INPUT)
        self.pi.set_pull_up_down(SENSOR_PIN, pigpio.PUD_UP)
        self.pi.set_glitch_filter(SENSOR_PIN, 5000)  # ノイズによる誤カウントを防ぐ
        self.encoder_cb = None  # コールバックは run() 内でCSVを開いてからバインド


        # モーター制御用のスレッドを開始
        threading.Thread(target=self.motor_loop, daemon=True).start()
        
        # arming (必須)
        """
        理由：DATASHEET Safety features : Every time SmartDriveDuo-30 is power up, the input data must be "stop" 
        (for RC, Analog, PWM input mode). This feature prevent the driver from sudden run, especially when the
        driver accidently reset.
        """
        self.pi.set_servo_pulsewidth(PIN, STOP_center)
        time.sleep(0.5)  # ESCアーミング待ち

    # =====================
    #   エンコーダー割り込み関数
    # =====================
    def detect_pulse(self, gpio, level, tick):  # pigpio コールバックは (gpio, level, tick) が必須
        with self.encoder_lock:
            self.pulse_count += 1
            revolutions = self.pulse_count / MAGNET_PAIRS
 
        elapsed_time = round(time.monotonic() - self.encoder_start_time, 3)
        length_mm = round((revolutions - (1 / MAGNET_PAIRS)) * WHEEL_CIRCUMFERENCE_MM, 2)
 
 
        if self.encoder_writer is not None:
            # [時間, 状態(0V), 回転数, 長さ(mm)] を書き込みます
            self.encoder_writer.writerow([elapsed_time, 0, revolutions, length_mm])
            # グラフを綺麗にするため、直後に立ち上がり（3.3V）をシミュレートします
            self.encoder_writer.writerow([elapsed_time + 0.001, 3.3, revolutions, length_mm])
            self.encoder_csv_file.flush()

    # =====================
    #   速度(%)をPWM値に変換する関数
    # =====================
    def calculate_pwm(self, direction, rate_percent):
        # サーバーからの速度指定が0以下の場合は停止
        if rate_percent <= 0:
            return STOP_center
        # 100%を超えないようにする
        if rate_percent > 100:
            rate_percent = 100
        # パーセントを計算用の小数(0.01 〜 1.00)にする
        ratio = rate_percent / 100.0
        if direction == 'fwd': # 巻き上げ
            # 1455 から 2000 の間で割合を計算
            return int(PWM_FWD_MIN + (PWM_FWD_MAX - PWM_FWD_MIN) * ratio)
        elif direction == 'rev': # 繰り出し
            # 1345 から 1200 の間で割合を計算 (逆転は数値が下がるほど速いので引き算)
            return int(PWM_REV_MAX - (PWM_REV_MAX - PWM_REV_MIN) * ratio)
        return STOP_center


    # =====================
    #   モータースレッド（滑らかな加減速）
    # =====================
    def motor_loop(self):
        while self.running:
            if self.emergency:
                self.current_pwm = STOP_center
                self.pi.set_servo_pulsewidth(PIN, STOP_center)
                time.sleep(0.1)
                continue
            # 目標と現在の差をチェックして、5、または20ずつ近づける
            if self.target_pwm in [STOP_center, STOP_fwd, STOP_rev]:
                step = 1  #素早く停止
                
            else:
                step = 1   #ゆっくり加速
            
            if self.current_pwm < self.target_pwm:
                if self.target_pwm >= STOP_fwd and (STOP_rev <= self.current_pwm < STOP_fwd):
                    self.current_pwm = STOP_fwd
                else:
                    self.current_pwm = min(self.current_pwm + step, self.target_pwm)
                self.pi.set_servo_pulsewidth(PIN, self.current_pwm)

            elif self.current_pwm > self.target_pwm:
                if self.target_pwm <= STOP_rev and (STOP_rev < self.current_pwm <= STOP_fwd):
                    self.current_pwm = STOP_rev
                else:
                    self.current_pwm = max(self.current_pwm - step, self.target_pwm)
                self.pi.set_servo_pulsewidth(PIN, self.current_pwm)


            if self.current_pwm > STOP_fwd:
                self.num_rotations -= (ESTIMATED_ROT_PER_SEC * 0.02)
            elif self.current_pwm < STOP_rev:
                self.num_rotations += (ESTIMATED_ROT_PER_SEC * 0.02)  
                
            if self.num_rotations < 0:
                self.num_rotations = 0.0
            
            time.sleep(0.02)   
            
    def get_simulated_depth(self):
        # エンコーダーのpulse_countから計算
        with self.encoder_lock:
            revolutions = self.pulse_count / MAGNET_PAIRS
        length_mm = (revolutions - (1 / MAGNET_PAIRS)) * WHEEL_CIRCUMFERENCE_MM
        return round(max(length_mm, 0) / 1000.0, 4)
    
    # =========================================
    #   メインループ (サーバー指令とPWM制御の架け橋)
    # =========================================

    def run(self):
        # TCP サーバーを別スレッドで起動 
        server_thread = threading.Thread(
            target=tcp_server,
            args=(self, self.port),
            daemon=True
        )
        server_thread.start()

        # エンコーダーCSVを開いてから割り込みを有効にする
        with open(ENCODER_CSV_FILENAME, mode='w', newline='') as f:
            self.encoder_csv_file = f
            self.encoder_writer = csv.writer(f)
            self.encoder_writer.writerow(['Time (s)', 'Voltage (V)', 'Cumulative Revolutions', 'Cable Length (mm)'])
            self.encoder_writer.writerow([0, 3.3, 0, 0])
            # FALLING_EDGE監視の開始
            self.encoder_cb = self.pi.callback(SENSOR_PIN, pigpio.FALLING_EDGE, self.detect_pulse)
 
            print("ウィンチ待機中... (Ctrl+C で終了)")
    
            # メインループ 
            while self.running:
                self.status.current_depth_m = self.get_simulated_depth()
                # 推定フラグ: 今はすべて推定値 (LiDAR実装後に切り替える)
                self.status.depth_estimated_flag = True
    
                # ---------------------------------------------------------
                # 状態遷移マシン
                # ---------------------------------------------------------
                
                if not self.cmd.run_flag: # サーバーから停止要求があった場合
                    # 完全に停止(1400)するまで SOFT_STOP を維持する
                    if self.current_pwm != STOP_center:
                        self.status.state_name = "SOFT_STOP"
                        self.status.run_flag = True # 物理的に停止するまではTrueを維持
                        # モーターに停止を指示 (実際の滑らかな減速はmotor_loopが行う)
                        self.target_pwm = STOP_center 
                        
                    else:
                        self.status.state_name = "IDLE"
                        self.status.run_flag = False # 完全に停止
                        self.target_pwm = STOP_center # 念のため停止を維持
                        self.reached_full_speed = False  #IDLEに戻った時にリセット
                        
                elif self.cmd.run_flag:
                    # サーバーから動作要求があった場合
                    if self.cmd.target_depth_m == 0:
                        self.status.state_name = "RETRIEVE_TO_HOME"
                        self.status.run_flag = True
    
                        depth = self.status.current_depth_m
                        slowdown_zone = 2.0
                        # リミットスイッチまで巻き上げるコード
                        limit_switch_pressed = (depth <= 0.1)
    
                        if limit_switch_pressed:
                            self.target_pwm = STOP_center
                            self.cmd.run_flag = False
                            self.num_rotations = 0.0
                            self.status.current_depth_m = 0.0
                            # エンコーダーもリセット
                            with self.encoder_lock:
                                self.pulse_count = 0
                            self.encoder_start_time = time.monotonic()
                        else:
                            # 残りの距離によって速度が変わる
                            if depth > slowdown_zone:
                                self.target_pwm = self.calculate_pwm('fwd', self.cmd.rate)
                            else:
                                self.target_pwm = self.calculate_pwm('fwd', 1)
                        
                        
                    else :
                        self.status.state_name = "TRACKING"
                        self.status.run_flag = True
                        target = self.cmd.target_depth_m
                        depth = self.status.current_depth_m
                        diff = target - depth
                        abs_diff = abs(diff)
    
                        tolerance = 0.2  # 許容誤差（0.2m以内に来たら停止）
                        slowdown_zone = 2.0
                        
                        if abs(diff) <= tolerance:
                            self.target_pwm = STOP_center
                            self.cmd.run_flag = False
                            
                        else:
                            # === 2段階制御  ===
                            if abs_diff <= slowdown_zone:
                                # 減速ゾーン: どんな速度で来ていても、安全な最低速度(クリープ速度)固定
                                active_rate =  1
                                if self.reached_full_speed:  # 一度でも全速で走ったことがある場合のみ
                                    self.status.state_name = "SLOW_DOWN"
                                else:
                                    self.status.state_name = "TRACKING"
                            else:
                                # 通常ゾーン: サーバーからの要求速度
                                active_rate = self.cmd.rate
                                self.reached_full_speed = True    # 通常ゾーンを通過した記録
                                self.status.state_name = "TRACKING"
    
                            # 決定した速度(active_rate)でモーターに指示を出す
                            if diff > 0:
                                self.target_pwm = self.calculate_pwm('rev', active_rate) 
                            elif diff < 0:
                                self.target_pwm = self.calculate_pwm('fwd', active_rate)
    
                # ---------------------------------------------------------
                # 実際のPWMからリアルタイムな速度を計算する
                # ---------------------------------------------------------
                if self.current_pwm == STOP_center:
                    self.status.speed = 0
                else:
                    # 加速中も減速中も、実際のモーターのPWMを見て速度を逆算する
                    approx_rate = abs(self.current_pwm - STOP_center) / 600.0
                    self.status.speed = int(approx_rate * (MAX_SPEED_M_MIN * 10))
    
                # 状態の表示 (サーバーへ返送されるデータのシミュレーション)
                print(
                    f"\r\033[K[Winch] 状態: {self.status.state_name:<15} | "
                    f"PWM: {self.current_pwm} | "
                    f"深度: {self.status.current_depth_m:>5.2f}m | "
                    f"目標: {self.cmd.target_depth_m:>5.2f}m | "
                    f"速度: {self.status.speed}",
                    end="", flush=True
                )
                
                time.sleep(0.1) # テスト用に毎秒2回ループ

    # プログラム終了時の安全な後処理
    def cleanup(self):
        self.running = False
        time.sleep(0.5)
        if hasattr(self, 'encoder_cb') and self.encoder_cb:
            self.encoder_cb.cancel()  # pigpio コールバックを解除
        if hasattr(self, 'pi') and self.pi.connected:
            self.pi.set_servo_pulsewidth(PIN, STOP_center)
            time.sleep(0.5)
            self.pi.set_servo_pulsewidth(PIN, 0)
            self.pi.stop()
        print("\r\nハードウェアを安全に停止しました。\r\n")


# ==========================================
# エントリーポイント
# ==========================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="ウィンチコントローラー TCP サーバー")
    parser.add_argument(
        "--port", "-p",
        type=int,
        default=DEFAULT_PORT,
        help=f"待受ポート番号 (デフォルト: {DEFAULT_PORT})"
    )
    args = parser.parse_args()
 
    app = WinchControllerV1(port=args.port)
    try:
        app.run()
    except KeyboardInterrupt:
        print("\n[Main] Ctrl+C を検出しました。終了します...")
    finally:
        app.cleanup()
 
